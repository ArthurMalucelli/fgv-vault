#!/usr/bin/env bash
set -eu

VAULT_INPUT=${FGV_VAULT_ROOT:-/root/vault}
LOCK_PATH=${FGV_SYNC_LOCK:-/run/lock/fgv-sync.lock}
OPERATIONAL_TIMEZONE=America/Sao_Paulo
EXPECTED_UPSTREAM=origin/codex/vault-plan-b
EXPECTED_BRANCH=codex/vault-plan-b
EXPECTED_REMOTE_URL=https://github.com/ArthurMalucelli/fgv-vault.git
AS_OF_DATE=${FGV_AS_OF_DATE:-$(TZ=$OPERATIONAL_TIMEZONE date +%F)}
LOCK_ACQUIRED=0
VALIDATION_WORKTREE=
VALIDATION_PARENT=

emit_blocked() {
  printf '{"operational_as_of":"%s","reason":"%s","status":"blocked"}\n' "$AS_OF_DATE" "$1"
}

emit_sync() {
  state=$1
  reason=$2
  commit=$3
  dirty=$4
  ahead=$5
  behind=$6
  printf '{"ahead":%s,"as_of_commit":"%s","behind":%s,"dirty":%s,"operational_as_of":"%s","reason":"%s","sync_state":"%s"}\n' \
    "$ahead" "$commit" "$behind" "$dirty" "$AS_OF_DATE" "$reason" "$state"
}

die() {
  code=$2
  emit_blocked "$1"
  exit "$code"
}

release_resources() {
  if [ -n "$VALIDATION_WORKTREE" ]; then
    git -C "$VAULT_ROOT" worktree remove --force "$VALIDATION_WORKTREE" >/dev/null 2>&1 || true
    VALIDATION_WORKTREE=
  fi
  if [ -n "$VALIDATION_PARENT" ]; then
    rmdir "$VALIDATION_PARENT" >/dev/null 2>&1 || true
    VALIDATION_PARENT=
  fi
  if [ "$LOCK_ACQUIRED" -eq 1 ]; then
    rmdir "$LOCK_PATH" >/dev/null 2>&1 || true
    LOCK_ACQUIRED=0
  fi
}

acquire_lock() {
  case "$LOCK_PATH" in
    /*) ;;
    *) die "lock_path_not_absolute" 64 ;;
  esac
  if ! mkdir "$LOCK_PATH" 2>/dev/null; then
    die "lock_busy" 75
  fi
  LOCK_ACQUIRED=1
  chmod 700 "$LOCK_PATH"
  trap release_resources EXIT HUP INT TERM
}

enter_repo() {
  case "$VAULT_INPUT" in
    /*) ;;
    *) die "vault_path_not_absolute" 64 ;;
  esac
  [ -d "$VAULT_INPUT" ] || die "vault_missing" 66
  cd "$VAULT_INPUT"
  VAULT_ROOT=$(pwd -P)
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "vault_not_git_repository" 65
  top=$(cd "$top" && pwd -P)
  [ "$top" = "$VAULT_ROOT" ] || die "vault_not_repository_root" 65
}

require_clean() {
  [ -z "$(git status --porcelain=v1 --untracked-files=all)" ] || die "working_tree_not_clean" 2
}

require_gate_files() {
  gate_root=$1
  for gate in .fgv/scripts/generate_state.py .fgv/scripts/validate_vault.py; do
    [ -f "$gate_root/$gate" ] || return 1
    [ ! -L "$gate_root/$gate" ] || return 1
  done
}

run_check_gates() {
  gate_root=$1
  require_gate_files "$gate_root" || return 10
  PYTHONDONTWRITEBYTECODE=1 python3 "$gate_root/.fgv/scripts/generate_state.py" \
    --vault "$gate_root" --as-of "$AS_OF_DATE" --check 1>&2 || return 11
  repository_binding_is_canonical || return 14
  PYTHONDONTWRITEBYTECODE=1 python3 "$gate_root/.fgv/scripts/validate_vault.py" \
    --vault "$gate_root" --as-of "$AS_OF_DATE" 1>&2 || return 12
  repository_binding_is_canonical || return 14
}

gate_reason() {
  case "$1" in
    10) printf required_gate_missing ;;
    11) printf state_check_failed ;;
    12) printf vault_validation_failed ;;
    13) printf gate_modified_worktree ;;
    14) printf repository_binding_changed ;;
    *) printf gate_failed ;;
  esac
}

fetch_origin() {
  git fetch --prune origin 1>&2
}

upstream_name() {
  git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null
}

branch_name() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null
}

normalize_origin_url() {
  case "$1" in
    "$EXPECTED_REMOTE_URL"|https://github.com/ArthurMalucelli/fgv-vault|https://github.com/ArthurMalucelli/fgv-vault/)
      printf '%s' "$EXPECTED_REMOTE_URL"
      ;;
    *) return 1 ;;
  esac
}

remote_binding_is_canonical() {
  origin_config_status=0
  configured_origin_urls=$(git config --get-all remote.origin.url 2>/dev/null) || origin_config_status=$?
  [ "$origin_config_status" -eq 0 ] || return 1
  [ -n "$configured_origin_urls" ] || return 1
  case "$configured_origin_urls" in *$'\n'*) return 1 ;; esac
  normalized_origin=$(normalize_origin_url "$configured_origin_urls" || true)
  [ "$normalized_origin" = "$EXPECTED_REMOTE_URL" ] || return 1

  push_config_status=0
  configured_push_urls=$(git config --get-all remote.origin.pushurl 2>/dev/null) || push_config_status=$?
  case "$push_config_status" in
    0)
      [ -n "$configured_push_urls" ] || return 1
      case "$configured_push_urls" in *$'\n'*) return 1 ;; esac
      normalized_push=$(normalize_origin_url "$configured_push_urls" || true)
      [ "$normalized_push" = "$EXPECTED_REMOTE_URL" ] || return 1
      ;;
    1) ;;
    *) return 1 ;;
  esac

  rewrite_config_status=0
  rewrite_config=$(git config --get-regexp '^url\.' 2>/dev/null) || rewrite_config_status=$?
  case "$rewrite_config_status" in 0|1) ;; *) return 1 ;; esac
  if [ "$rewrite_config_status" -eq 0 ]; then
    while IFS=' ' read -r rewrite_key rewrite_value; do
      case "$rewrite_key" in
        *.insteadof|*.pushinsteadof|*.insteadOf|*.pushInsteadOf) return 1 ;;
      esac
    done <<< "$rewrite_config"
  fi

  push_route_status=0
  git config --get "branch.$EXPECTED_BRANCH.pushRemote" >/dev/null 2>&1 || push_route_status=$?
  case "$push_route_status" in 1) ;; *) return 1 ;; esac
  push_route_status=0
  git config --get remote.pushDefault >/dev/null 2>&1 || push_route_status=$?
  case "$push_route_status" in 1) ;; *) return 1 ;; esac

  effective_fetch_status=0
  effective_fetch_urls=$(git remote get-url --all origin 2>/dev/null) || effective_fetch_status=$?
  [ "$effective_fetch_status" -eq 0 ] || return 1
  [ -n "$effective_fetch_urls" ] || return 1
  case "$effective_fetch_urls" in *$'\n'*) return 1 ;; esac
  normalized_fetch=$(normalize_origin_url "$effective_fetch_urls" || true)
  [ "$normalized_fetch" = "$EXPECTED_REMOTE_URL" ] || return 1

  effective_push_status=0
  effective_push_urls=$(git remote get-url --push --all origin 2>/dev/null) || effective_push_status=$?
  [ "$effective_push_status" -eq 0 ] || return 1
  [ -n "$effective_push_urls" ] || return 1
  case "$effective_push_urls" in *$'\n'*) return 1 ;; esac
  normalized_effective_push=$(normalize_origin_url "$effective_push_urls" || true)
  [ "$normalized_effective_push" = "$EXPECTED_REMOTE_URL" ] || return 1
}

repository_binding_is_canonical() {
  branch=$(branch_name || true)
  [ "$branch" = "$EXPECTED_BRANCH" ] || return 1
  upstream=$(upstream_name || true)
  [ "$upstream" = "$EXPECTED_UPSTREAM" ] || return 1
  remote_binding_is_canonical
}

require_repository_binding() {
  branch=$(branch_name || true)
  [ "$branch" = "$EXPECTED_BRANCH" ] || die "upstream_mismatch" 2
  upstream=$(upstream_name || true)
  [ "$upstream" = "$EXPECTED_UPSTREAM" ] || die "upstream_mismatch" 2
  remote_binding_is_canonical || die "origin_remote_mismatch" 2
}

require_repository_binding_unchanged() {
  repository_binding_is_canonical || die "repository_binding_changed" 2
}

relation_counts() {
  git rev-list --left-right --count "HEAD...$1" 2>/dev/null
}

status_command() {
  acquire_lock
  enter_repo
  head=$(git rev-parse HEAD 2>/dev/null) || die "head_missing" 65
  status_before=$(git status --porcelain=v1 --untracked-files=all)
  if [ -n "$status_before" ]; then dirty=true; else dirty=false; fi
  branch=$(branch_name || true)
  upstream=$(upstream_name || true)
  if [ "$branch" != "$EXPECTED_BRANCH" ] || [ "$upstream" != "$EXPECTED_UPSTREAM" ]; then
    emit_sync unknown upstream_mismatch "$head" "$dirty" 0 0
    exit 2
  fi
  if ! remote_binding_is_canonical; then
    emit_sync unknown origin_remote_mismatch "$head" "$dirty" 0 0
    exit 2
  fi
  if ! fetch_origin; then
    emit_sync unknown fetch_failed "$head" "$dirty" 0 0
    exit 2
  fi
  counts=$(relation_counts "$upstream" || true)
  if [ -z "$counts" ]; then
    emit_sync unknown divergence_check_failed "$head" "$dirty" 0 0
    exit 2
  fi
  ahead=${counts%%[[:space:]]*}
  behind=${counts##*[[:space:]]}
  if [ "$dirty" = true ]; then
    emit_sync dirty working_tree_not_clean "$head" true "$ahead" "$behind"
    exit 2
  fi
  gate_code=0
  run_check_gates "$VAULT_ROOT" || gate_code=$?
  if [ "$gate_code" -ne 0 ]; then
    if [ "$gate_code" -eq 14 ]; then gate_state=unknown; else gate_state=stale; fi
    emit_sync "$gate_state" "$(gate_reason "$gate_code")" "$head" "$dirty" "$ahead" "$behind"
    exit 2
  fi
  [ "$(git status --porcelain=v1 --untracked-files=all)" = "$status_before" ] || {
    emit_sync stale gate_modified_worktree "$head" true "$ahead" "$behind"
    exit 2
  }
  if [ "$ahead" -gt 0 ]; then
    emit_sync unknown branch_diverged_or_ahead "$head" false "$ahead" "$behind"
    exit 2
  fi
  if [ "$behind" -gt 0 ]; then
    emit_sync stale remote_ahead "$head" false 0 "$behind"
    exit 2
  fi
  emit_sync clean synchronized "$head" false 0 0
}

validate_target_commit() {
  target=$1
  VALIDATION_PARENT=$(mktemp -d "${TMPDIR:-/tmp}/fgv-sync.XXXXXX") || die "temporary_worktree_failed" 2
  VALIDATION_WORKTREE="$VALIDATION_PARENT/candidate"
  git worktree add --detach "$VALIDATION_WORKTREE" "$target" 1>&2 || die "temporary_worktree_failed" 2
  gate_code=0
  run_check_gates "$VALIDATION_WORKTREE" || gate_code=$?
  if [ "$gate_code" -eq 0 ] && [ -n "$(git -C "$VALIDATION_WORKTREE" status --porcelain=v1 --untracked-files=all)" ]; then
    gate_code=13
  fi
  if [ "$gate_code" -ne 0 ]; then
    die "$(gate_reason "$gate_code")" 2
  fi
  validated=$(git -C "$VALIDATION_WORKTREE" rev-parse HEAD 2>/dev/null) || die "candidate_head_missing" 2
  [ "$validated" = "$target" ] || die "candidate_commit_changed" 2
  git worktree remove --force "$VALIDATION_WORKTREE" 1>&2 || die "temporary_worktree_cleanup_failed" 2
  VALIDATION_WORKTREE=
  rmdir "$VALIDATION_PARENT" || die "temporary_worktree_cleanup_failed" 2
  VALIDATION_PARENT=
}

refresh() {
  acquire_lock
  enter_repo
  require_repository_binding
  require_clean
  original_head=$(git rev-parse HEAD 2>/dev/null) || die "head_missing" 65
  fetch_origin || die "fetch_failed" 2
  counts=$(relation_counts "$upstream" || true)
  [ -n "$counts" ] || die "divergence_check_failed" 2
  ahead=${counts%%[[:space:]]*}
  behind=${counts##*[[:space:]]}
  [ "$ahead" -eq 0 ] || die "branch_diverged_or_ahead" 2
  target=$(git rev-parse "$upstream" 2>/dev/null) || die "upstream_commit_missing" 2
  validate_target_commit "$target"
  require_repository_binding_unchanged
  [ "$(git rev-parse HEAD)" = "$original_head" ] || die "production_head_changed_during_validation" 2
  require_clean
  if [ "$behind" -gt 0 ]; then
    git merge --ff-only "$target" 1>&2 || die "fast_forward_failed" 2
  fi
  require_repository_binding_unchanged
  [ "$(git rev-parse HEAD)" = "$target" ] || die "fast_forward_target_mismatch" 2
  require_clean
  emit_sync clean synchronized "$target" false 0 0
}

valid_publish_path() {
  candidate=$1
  case "$candidate" in
    ""|/*|../*|*/../*|*/..|./*|*/./*|*/.|.git|.git/*|*$'\n'*|*$'\r'*) return 1 ;;
  esac
  [ ! -L "$candidate" ] || return 1
  [ -f "$candidate" ] || return 1
}

path_in_scope() {
  candidate=$1
  shift
  for allowed in "$@"; do
    [ "$candidate" = "$allowed" ] && return 0
  done
  return 1
}

scope_is_closed() {
  while IFS= read -r -d '' line; do
    [ -n "$line" ] || continue
    state=${line:0:2}
    candidate=${line:3}
    case "$state" in *R*|*C*) return 1 ;; esac
    path_in_scope "$candidate" "${PUBLISH_PATHS[@]}" || return 1
  done < <(git status --porcelain=v1 --untracked-files=all -z)
}

publish() {
  shift
  message=
  PUBLISH_PATHS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --message)
        [ "$#" -ge 2 ] || die "message_value_missing" 64
        message=$2
        shift 2
        ;;
      --path)
        [ "$#" -ge 2 ] || die "path_value_missing" 64
        PUBLISH_PATHS+=("$2")
        shift 2
        ;;
      *) die "unknown_publish_argument" 64 ;;
    esac
  done
  [ -n "$message" ] || die "message_missing" 64
  case "$message" in *$'\n'*|*$'\r'*) die "message_must_be_one_line" 64 ;; esac
  [ "${#PUBLISH_PATHS[@]}" -gt 0 ] || die "publish_path_missing" 64

  acquire_lock
  enter_repo
  require_repository_binding
  for candidate in "${PUBLISH_PATHS[@]}"; do
    valid_publish_path "$candidate" || die "unsafe_publish_path" 64
  done
  [ -z "$(git diff --cached --name-only)" ] || die "preexisting_staged_changes" 2
  scope_is_closed || die "changes_outside_scope" 2

  fetch_origin || die "fetch_failed" 2
  counts=$(relation_counts "$upstream" || true)
  [ -n "$counts" ] || die "divergence_check_failed" 2
  ahead=${counts%%[[:space:]]*}
  behind=${counts##*[[:space:]]}
  [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ] || die "branch_not_synchronized" 2

  require_gate_files "$VAULT_ROOT" || die "required_gate_missing" 2
  PYTHONDONTWRITEBYTECODE=1 python3 "$VAULT_ROOT/.fgv/scripts/generate_state.py" \
    --vault "$VAULT_ROOT" --as-of "$AS_OF_DATE" 1>&2 || die "state_rebuild_failed" 2
  require_repository_binding_unchanged
  PYTHONDONTWRITEBYTECODE=1 python3 "$VAULT_ROOT/.fgv/scripts/generate_state.py" \
    --vault "$VAULT_ROOT" --as-of "$AS_OF_DATE" --check 1>&2 || die "state_check_failed" 2
  require_repository_binding_unchanged
  PYTHONDONTWRITEBYTECODE=1 python3 "$VAULT_ROOT/.fgv/scripts/validate_vault.py" \
    --vault "$VAULT_ROOT" --as-of "$AS_OF_DATE" 1>&2 || die "vault_validation_failed" 2
  require_repository_binding_unchanged
  scope_is_closed || die "changes_outside_scope" 2

  git add -- "${PUBLISH_PATHS[@]}" || die "stage_failed" 2
  [ -n "$(git diff --cached --name-only)" ] || die "nothing_to_publish" 2
  while IFS= read -r -d '' candidate; do
    [ -n "$candidate" ] || continue
    path_in_scope "$candidate" "${PUBLISH_PATHS[@]}" || die "staged_path_outside_scope" 2
  done < <(git diff --cached --name-only -z)
  require_repository_binding_unchanged
  git commit -m "$message" 1>&2 || die "commit_failed" 2
  require_repository_binding_unchanged
  git push origin HEAD:refs/heads/codex/vault-plan-b 1>&2 || die "push_failed" 2
  require_clean
  head=$(git rev-parse HEAD)
  emit_sync clean synchronized "$head" false 0 0
}

CURRENT_OPERATIONAL_AS_OF=$(TZ=$OPERATIONAL_TIMEZONE date +%F)
if [ "$AS_OF_DATE" != "$CURRENT_OPERATIONAL_AS_OF" ]; then
  emit_blocked operational_as_of_stale
  exit 2
fi

[ "$#" -ge 1 ] || die "subcommand_missing" 64
case "$1" in
  status)
    [ "$#" -eq 1 ] || die "status_takes_no_arguments" 64
    status_command
    ;;
  refresh)
    [ "$#" -eq 1 ] || die "refresh_takes_no_arguments" 64
    refresh
    ;;
  publish)
    publish "$@"
    ;;
  *) die "unknown_subcommand" 64 ;;
esac
