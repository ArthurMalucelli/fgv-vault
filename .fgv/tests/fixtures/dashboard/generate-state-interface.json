{
  "schema_version": 1,
  "command": [
    "python3",
    ".fgv/scripts/generate_state.py",
    "--vault",
    "<vault>",
    "--as-of",
    "YYYY-MM-DD"
  ],
  "check_flag": "--check",
  "exit_codes": {
    "0": "fresh_or_generated",
    "1": "stale_in_check_mode",
    "2": "invalid_or_failed"
  }
}
